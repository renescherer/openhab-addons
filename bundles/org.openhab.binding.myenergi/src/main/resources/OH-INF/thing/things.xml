<?xml version="1.0" encoding="UTF-8" ?>
<?xml-stylesheet href="things.xsl" type="text/xsl" ?>

<thing:thing-descriptions bindingId="myenergi"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">
	<bridge-type id="bridge">

		<label>MyEnergi API Bridge</label>
		<description>The MyEnergi Cloud API Bridge</description>

		<config-description>
			<parameter name="hubSerialNumber" type="text" required="true">
				<label>Hub Serial Number.</label>
				<description>The Hub Serial Number to access the MyEnergi API ()</description>
			</parameter>
			<parameter name="password" type="text" required="true">
				<label>Password</label>
				<description>The password to access the MyEnergi API (same as the smart phone app password)</description>
				<context>password</context>
			</parameter>
			<parameter name="refreshInterval" type="integer" required="false" min="1">
				<label>Topology Refresh Interval</label>
				<description>Query interval (in hours) for device topology</description>
				<default>24</default>
			</parameter>
		</config-description>

	</bridge-type>

	<thing-type id="harvi">
		<supported-bridge-type-refs>
			<bridge-type-ref id="bridge"/>
		</supported-bridge-type-refs>

		<label>Harvi</label>
		<description>MyEnergi Harvi device</description>

		<channels>
			<channel id="lastUpdatedTime" typeId="lastUpdatedTimeType"/>
			<channel id="clampName1" typeId="CTType"/>
			<channel id="clampName2" typeId="CTType"/>
			<channel id="clampName3" typeId="CTType"/>
			<channel id="clampPower1" typeId="clampPowerType">
				<label>CT Power L1</label>
			</channel>
			<channel id="clampPower2" typeId="clampPowerType">
				<label>CT Power L2</label>
			</channel>
			<channel id="clampPower3" typeId="clampPowerType">
				<label>CT Power L3</label>
			</channel>
			<channel id="clampPhase1" typeId="phaseType">
				<label>CT Phase L1</label>
			</channel>
			<channel id="clampPhase2" typeId="phaseType">
				<label>CT Phase L2</label>
			</channel>
			<channel id="clampPhase3" typeId="phaseType">
				<label>CT Phase L3</label>
			</channel>
		</channels>

		<properties>
			<property name="serialNumber"/>
			<property name="firmwareVersion"/>
		</properties>

	</thing-type>

	<thing-type id="zappi">
		<supported-bridge-type-refs>
			<bridge-type-ref id="bridge"/>
		</supported-bridge-type-refs>

		<label>Zappi</label>
		<description>MyEnergi Zappi</description>
		<category>PowerOutlet</category>
		<channel-groups>
			<channel-group id="device" typeId="deviceGroupType"/>
			<channel-group id="clamp" typeId="clampGroupType"/>
			<channel-group id="manualBoost" typeId="manualBoostGroupType"/>
			<channel-group id="smartBoost" typeId="smartBoostGroupType"/>
			<channel-group id="timedBoostSlot1" typeId="timedBoostSlotGroupType">
				<label>Timed Boost Slot 1</label>
			</channel-group>
			<channel-group id="timedBoostSlot2" typeId="timedBoostSlotGroupType">
				<label>Timed Boost Slot 2</label>
			</channel-group>
			<channel-group id="timedBoostSlot3" typeId="timedBoostSlotGroupType">
				<label>Timed Boost Slot 3</label>
			</channel-group>
			<channel-group id="timedBoostSlot4" typeId="timedBoostSlotGroupType">
				<label>Timed Boost Slot 4</label>
			</channel-group>
		</channel-groups>
		<properties>
			<property name="serialNumber"/>
			<property name="firmwareVersion"/>
		</properties>


		<config-description>
			<parameter name="refreshInterval" type="integer" required="false" min="5">
				<label>Refresh Interval</label>
				<description>Query interval (in seconds) for device measurements (generation, consumption etc.)</description>
				<default>30</default>
			</parameter>
		</config-description>
	</thing-type>

	<channel-group-type id="deviceGroupType">
		<label>Device</label>
		<channels>
			<channel id="lastUpdatedTime" typeId="lastUpdatedTimeType"/>
			<channel id="numberOfPhases" typeId="numberOfPhasesType"/>
			<channel id="lockingMode" typeId="lockingModeType"/>
			<channel id="chargingMode" typeId="chargingModeType"/>
			<channel id="status" typeId="statusType"/>
			<channel id="plugStatus" typeId="plugStatusType"/>
			<channel id="commandTries" typeId="commandTriesType"/>
			<channel id="diverterPriority" typeId="diverterPriorityType"/>
			<channel id="minimumGreenLevel" typeId="minimumGreenLevelType"/>
			<channel id="supplyVoltage" typeId="voltageType"/>
			<channel id="supplyFrequency" typeId="frequencyType"/>
			<channel id="gridPower" typeId="PowerType">
				<label>Imported or Exported Grid Power</label>
			</channel>
			<channel id="generatedPower" typeId="PowerType">
				<label>Generated Power(Solar or Wind)</label>
			</channel>
			<channel id="divertedPower" typeId="PowerType">
				<label>Diverted Power</label>
			</channel>
			<channel id="consumedPower" typeId="PowerType">
				<label>Consumed Power</label>
			</channel>
			<channel id="chargeAdded" typeId="PowerType">
				<label>Charge Added</label>
			</channel>
		</channels>
	</channel-group-type>

	<channel-group-type id="clampGroupType">
		<label>Zappi CT</label>
		<channels>
			<channel id="clampName1" typeId="CTType">
				<label>CT Type L1</label>
			</channel>

			<channel id="clampName2" typeId="CTType">
				<label>CT Type L2</label>
			</channel>

			<channel id="clampName3" typeId="CTType">
				<label>CT Type L3</label>
			</channel>

			<channel id="clampPower1" typeId="clampPowerType">
				<label>CT Power L1</label>
			</channel>
			<channel id="clampPower2" typeId="clampPowerType">
				<label>CT Power L1</label>
			</channel>
			<channel id="clampPower3" typeId="clampPowerType">
				<label>CT Power L1</label>
			</channel>
		</channels>
	</channel-group-type>

	<channel-group-type id="manualBoostGroupType">
		<label>Manual Boost</label>
		<channels>
			<channel id="boostStatus" typeId="boostStatusType"/>
			<channel id="manualBoostCharge" typeId="chargeType">
				<label>Manual Boost Charge</label>
			</channel>
			<channel id="newManualBoostCharge" typeId="chargeTypeWriteable">
				<label>New Manual Boost Charge</label>
			</channel>
			<channel id="stopAll" typeId="stopAllType"/>
		</channels>
	</channel-group-type>
	<channel-group-type id="smartBoostGroupType">
		<label>Smart Boost Slot</label>
		<channels>
			<channel id="boostStatus" typeId="boostStatusType"/>
			<channel id="endTimeHour" typeId="timeTypeReadonly">
				<label>Previous Ending Time (Hour)</label>
			</channel>
			<channel id="endTimeMinute" typeId="timeTypeReadonly">
				<label>Previous Ending Time (Minute)</label>
			</channel>
			<channel id="smartBoostCharge" typeId="chargeType">
				<label>Previous Energy to Charge</label>
				<description>Energy configured for the previous smart boost.</description>
			</channel>
			<channel id="newSmartBoostCharge" typeId="chargeTypeWriteable">
				<label>Next Energy to Charge</label>
				<description>Energy configured for the next smart boost.</description>
			</channel>
			<channel id="newEndTimeHour" typeId="hourTypeWritable">
				<label>Next Ending Time (Hour)</label>
			</channel>
			<channel id="newEndTimeMinute" typeId="minuteTypeWritable">
				<label>Next Ending Time (Minute)</label>
			</channel>

			<channel id="stopAll" typeId="stopAllType"/>
		</channels>
	</channel-group-type>

	<channel-group-type id="timedBoostSlotGroupType">
		<label>Timed Boost Slot</label>
		<description>All channels for one related Timed Boost Slot</description>
		<channels>

			<channel id="monday" typeId="DayOfWeekType">
				<label>Monday</label>
			</channel>
			<channel id="tuesday" typeId="DayOfWeekType">
				<label>Tuesday</label>
			</channel>
			<channel id="wednesday" typeId="DayOfWeekType">
				<label>Wednesday</label>
			</channel>
			<channel id="thursday" typeId="DayOfWeekType">
				<label>Thursday</label>
			</channel>
			<channel id="friday" typeId="DayOfWeekType">
				<label>Friday</label>
			</channel>
			<channel id="saturday" typeId="DayOfWeekType">
				<label>Saturday</label>
			</channel>
			<channel id="sunday" typeId="DayOfWeekType">
				<label>Sunday</label>
			</channel>
			<channel id="startHour" typeId="hourTypeWritable">
				<label>Start Hour</label>
			</channel>
			<channel id="startMinute" typeId="minuteTypeWritable">
				<label>Start Minute</label>
			</channel>
			<channel id="duration" typeId="durationType"/>
		</channels>
	</channel-group-type>
	<channel-group-type id="clampGroupType">
		<label>CT</label>
		<channels>
			<channel id="clampName1" typeId="CTType">
				<label>CT Type(Usage) L1</label>
			</channel>
			<channel id="clampName2" typeId="CTType">
				<label>CT Type(Usage) L2</label>
			</channel>
			<channel id="clampName3" typeId="CTType">
				<label>CT Type(Usage) L3</label>
			</channel>
			<channel id="clampPower1" typeId="clampPowerType">
				<label>CT Power L1</label>
			</channel>
			<channel id="clampPower2" typeId="clampPowerType">
				<label>CT Power L2</label>
			</channel>
			<channel id="clampPower3" typeId="clampPowerType">
				<label>CT Power L3</label>
			</channel>
		</channels>
	</channel-group-type>

	<channel-type id="lastUpdatedTimeType">
		<item-type>DateTime</item-type>
		<label>Last Updated Time</label>
		<description>The time when the device was last updated</description>
		<state readOnly="true" pattern="%1$tF %1$tR"/>
	</channel-type>

	<channel-type id="CTType">
		<item-type>String</item-type>
		<label>CT Type(Usage)</label>
		<state readOnly="true" pattern="%s">
			<options>
				<option value="None">None</option>
				<option value="Grid">Grid</option>
				<option value="Generation Only">Generation Only</option>
				<option value="Storage Only">Storage Only</option>
				<option value="Gen &amp; Battery">Gen &amp; Battery</option>
				<option value="Monitor">Monitor</option>
				<option value="AC Battery">AC Battery</option>
			</options>
		</state>

	</channel-type>

	<channel-type id="PowerType">
		<item-type>Number:Power</item-type>
		<label>Power</label>
		<category>Energy</category>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="clampPowerType">
		<item-type>Number:Power</item-type>
		<label>Clamp Power L1</label>
		<description>The measured power at the CT L1</description>
		<category>Energy</category>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="phaseType">
		<item-type>Number</item-type>
		<label>Phase</label>
		<description>The phase this CT is attached to</description>
		<category>Energy</category>
		<state readOnly="true" pattern="%d"/>
	</channel-type>

	<channel-type id="numberOfPhasesType">
		<item-type>Number</item-type>
		<label>Number of Phases</label>
		<description>The number of phases in the installation</description>
		<state readOnly="true" pattern="%d"/>
	</channel-type>

	<channel-type id="voltageType">
		<item-type>Number:ElectricPotential</item-type>
		<label>Voltage</label>
		<description>Supply voltage to the unit</description>
		<category>Energy</category>
		<state readOnly="true" pattern="%d %unit%"/>
	</channel-type>

	<channel-type id="frequencyType">
		<item-type>Number:Frequency</item-type>
		<label>Frequency</label>
		<description>Grid frequency</description>
		<category>Energy</category>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="chargeType">
		<item-type>Number:Energy</item-type>
		<label>Charge</label>
		<description>Energy supplied to the EV during current charge session</description>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>
	<channel-type id="chargeTypeWriteable">
		<item-type>Number:Energy</item-type>
		<label>Charge</label>
		<description>Energy to be supplied to the EV in the next charge session</description>
		<state min="0" max="100" step="1" readOnly="false" pattern="%.1f %unit%"/>
	</channel-type>
	<channel-type id="lockingModeType">
		<item-type>Number</item-type>
		<label>Locking Mode</label>
		<description>The current locking mode of the device as bitmap.
			Bit 0: Locked Now,
			Bit 1: Lock when plugged in,
			Bit 2:
			Lock when unplugged,
			Bit 3: Charge when locked,
			Bit 4: Charge Session Allowed (Even if locked)</description>
		<state readOnly="true" pattern="%d"/>
	</channel-type>

	<channel-type id="chargingModeType">
		<item-type>String</item-type>
		<label>Charging Mode</label>
		<description>The current charging mode of the device (One of Boost, Fast, Eco, Eco+ or Stop)</description>
		<state readOnly="false">
			<options>
				<option value="0">Boost</option>
				<option value="1">Fast</option>
				<option value="2">Eco</option>
				<option value="3">Eco+</option>
				<option value="4">Stop</option>
			</options>
		</state>
	</channel-type>

	<channel-type id="statusType">
		<item-type>String</item-type>
		<label>Status</label>
		<description>The current status of the device (E.g. Starting, Waiting for Export ...)</description>
		<state readOnly="true">
			<options>
				<option value="0">Starting</option>
				<option value="1">Waiting for Export</option>
				<option value="2">Demand Side Response</option>
				<option value="3">Diverting</option>
				<option value="4">Boosting</option>
				<option value="5">Charge Complete</option>
			</options>
		</state>
	</channel-type>

	<channel-type id="plugStatusType">
		<item-type>String</item-type>
		<label>Plug Status</label>
		<description>The current plug status of the device (E.g. Disconnected. Awaiting Surplus, Charge Complete ...)</description>
		<state readOnly="true">
			<options>
				<option value="A">Disconnected</option>
				<option value="B1">Awaiting Surplus</option>
				<option value="B2">Charge Complete</option>
				<option value="C1">Transitory - unknown</option>
				<option value="C2">Charging Max Power</option>
				<option value="F">Fault/Restart</option>
			</options>
		</state>
	</channel-type>

	<channel-type id="commandTriesType">
		<item-type>Number</item-type>
		<label>Command Status/Retries</label>
		<description>0-10 Trying, 253 Acked and Failed, 254 Acked and OK, 255 No command has ever been sent</description>
		<state readOnly="true" pattern="%d"/>
	</channel-type>

	<channel-type id="diverterPriorityType">
		<item-type>Number</item-type>
		<label>Diverter Priority</label>
		<description>The diverter priority</description>
		<state readOnly="true" pattern="%d"/>
	</channel-type>

	<channel-type id="minimumGreenLevelType">
		<item-type>Number</item-type>
		<label>Minimum Green Level</label>
		<description>The minimum percentage of green energy to allow charging</description>
		<state readOnly="false" pattern="%d %%"/>
		<autoUpdatePolicy>recommend</autoUpdatePolicy>
	</channel-type>
	<channel-type id="boostStatusType">
		<item-type>Switch</item-type>
		<label>Boost Status</label>
		<description>Is ON if boost is active. Switch it to ON to start a new boost.</description>
		<state readOnly="false"/>
	</channel-type>
	<channel-type id="boostEndTimeType">
		<item-type>String</item-type>
		<label>Boost End Time</label>
		<description>The time when the boost process should finish (HH:MM)</description>
		<state readOnly="false" pattern="%s"/>
	</channel-type>
	<channel-type id="DayOfWeekType">
		<item-type>Switch</item-type>
		<label>Day</label>
		<state readOnly="false"/>
	</channel-type>
	<channel-type id="timeTypeReadonly">
		<item-type>Number</item-type>
		<label>Time</label>
		<state readOnly="false" pattern="%d"/>
	</channel-type>
	<channel-type id="hourTypeWritable">
		<item-type>Number</item-type>
		<label>Time</label>
		<state min="0" max="24" step="1" pattern="%d"/>
	</channel-type>
	<channel-type id="minuteTypeWritable">
		<item-type>Number</item-type>
		<label>Time</label>
		<state min="0" max="60" step="15" pattern="%d"/>
	</channel-type>
	<channel-type id="durationType">
		<item-type>Number</item-type>
		<label>Duration in Hours</label>
		<description>E.g. 1.5. Maximum duration is 10h</description>
		<state min="0" max="10" step="0.25" pattern="%d"/>
		<autoUpdatePolicy>recommend</autoUpdatePolicy>
	</channel-type>
	<channel-type id="stopAllType">
		<item-type>Switch</item-type>
		<label>Stop all Boosts</label>
		<state readOnly="false"/>
	</channel-type>
</thing:thing-descriptions>
